# Browser-side proxy paths (served by the rewrites in next.config.js).
# Optional -- lib/config/api.js falls back to these exact values.
# NEXT_PUBLIC_API_BASE_URL=/hrms-proxy
# NEXT_PUBLIC_CHATBOT_API_URL=/chatbot-proxy

# Upstream origins the rewrites point at. Server-side rendering calls these
# directly. Override only to point at a local backend during development.
# LOCAL_HRMS_URL=http://localhost:5005
# LOCAL_CHATBOT_URL=http://localhost:5005
